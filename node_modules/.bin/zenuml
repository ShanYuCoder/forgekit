#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/home/vutv/workspace/forgekit/node_modules/@zenuml/core/node_modules:/home/vutv/workspace/forgekit/node_modules:/home/vutv/workspace/forgekit/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/home/vutv/workspace/forgekit/node_modules/@zenuml/core/node_modules:/home/vutv/workspace/forgekit/node_modules:/home/vutv/workspace/forgekit/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/bun" ]; then
  exec "$basedir/bun"  "$basedir/../@zenuml/core/dist/cli/zenuml.mjs" "$@"
else
  exec bun  "$basedir/../@zenuml/core/dist/cli/zenuml.mjs" "$@"
fi
